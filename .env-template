# ==============================
# PostgreSQL 数据库配置
# ==============================
# 数据库主机地址（使用 docker-compose 内置的填 postgres，使用外部数据库填实际IP）
DB_HOST=127.0.0.1
# 数据库端口
DB_PORT=5432
# 数据库名
DB_NAME=codenote
# 数据库用户名
DB_USER=postgres
# 数据库密码
DB_PASSWORD=postgres

# ==============================
# MinIO 对象存储配置
# ==============================
# MinIO 地址（使用 docker-compose 内置的填 http://minio:9000，使用外部的填实际地址）
MINIO_ENDPOINT=http://127.0.0.1:9000
# MinIO Access Key
MINIO_ACCESS_KEY=minioadmin
# MinIO Secret Key
MINIO_SECRET_KEY=minioadmin
# Bucket 名称
MINIO_BUCKET=codenote
# MinIO API 端口（仅 docker-compose 内置时有效）
MINIO_PORT=9000
# MinIO 控制台端口（仅 docker-compose 内置时有效）
MINIO_CONSOLE_PORT=9001

# ==============================
# JWT 认证配置
# ==============================
JWT_SECRET=please_change_this_to_a_very_long_random_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# ==============================
# CORS 配置（允许访问的前端域名，多个用逗号分隔，生产环境建议指定具体域名）
# ==============================
CORS_ALLOWED_ORIGINS=*

# ==============================
# 服务端口映射
# ==============================
# 后端服务端口
BACKEND_PORT=8080
# 前端服务端口
FRONTEND_PORT=3000

# ==============================
# 是否启用 docker-compose 内置的 PostgreSQL 和 MinIO
# 设为 false 表示使用外部服务（需要正确配置上面的 DB_HOST 和 MINIO_ENDPOINT）
# ==============================
ENABLE_POSTGRES=false
ENABLE_MINIO=false
